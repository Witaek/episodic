{
	"name": "episodic",
	"version": "2.2.0",
	"private": true,
	"description": "Self-hosted tracker for TV shows, anime and movies",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:e2e": "rm -rf test-results/e2e-data && playwright test",
		"icons": "node scripts/generate-icons.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"@types/web-push": "3.6.4",
		"drizzle-kit": "0.31.11",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sharp": "0.35.5",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.59.0",
		"@node-rs/argon2": "2.2.2",
		"barcode-detector": "3.2.2",
		"better-sqlite3": "13.0.3",
		"bits-ui": "2.19.5",
		"croner": "10.0.1",
		"drizzle-orm": "0.45.4",
		"svelte-sonner": "1.2.1",
		"web-push": "3.6.7",
		"zod": "4.6.7",
		"zxing-wasm": "3.1.3"
	}
}
