# Copy to .env and fill in. Used by `docker compose` and by `npm run dev`.
# Every variable is documented in docs/configuration.md.

# Required: TMDB "API Read Access Token" (docs/api-keys.md)
TMDB_ACCESS_TOKEN=

# Port on the host
PORT=8787

# Main URL you open Episodic from, and any others (comma separated)
APP_URL=
ALLOWED_ORIGINS=

# Where the database and backups live on the host
DATA_DIR=/DATA/AppData/episodic

TZ=Europe/Paris
PUID=1000
PGID=1000

METADATA_LANGUAGE=en-US
METADATA_REGION=US
BACKUP_RETENTION_DAYS=14
